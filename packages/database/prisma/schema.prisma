generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Direction {
  ltr
  rtl
}

enum BlockCategory {
  project
  blog
  news
  event
  about_us
}

enum FileType {
  image
  video
  pdf
}

enum AdminRole {
  administrator
  employee
  financial_officer
}

enum Representation {
  personal
  company
  organization
}

enum ProjectCategory {
  agricultural
  industrial
  trading
}

enum DonationStatus {
  pending
  approved
  rejected
  cancelled
}

enum StudyStatus {
  draft
  in_review
  published
  voting_open
  voting_closed
  approved
  rejected
}

enum SectionStatus {
  pending
  in_progress
  completed
  needs_revision
}

enum VoteChoice {
  for
  against
  abstain
}

enum ProjectType {
  agricultural
  industrial
  infrastructure
  energy
  housing
  trading
}

enum PaymentProvider {
  stripe
  paypal
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum StepStatus {
  pending
  assigned
  in_progress
  completed
  verified
  cancelled
}

enum PhaseStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
  missed
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

enum TransactionType {
  income
  expense
  refund
  adjustment
}

// ─── W8 — fund classification, recipients & the Expense successor to
// ProjectExpense (03_DATA_MODEL.md addendum: "retires in Wave 8") ────────────

enum FundType {
  // W9 — sector-level fund at the root of a category's hierarchy branch. No
  // owner (not org/council/donor-backed): it represents the taxonomy node
  // itself. One master fund per ProjectCategoryNode, auto-created on first
  // use — see FundHierarchyService.
  master
  organization
  council
  donor
}

// Shared classification for the two counterparties of money movement: who a
// Fund's money comes from (Donor), and who an Expense pays out to (Recipient).
enum PartyType {
  person
  company
  organization
}

// W9-stabilization — Funding Platform Audit §3: standard civic project
// execution lifecycle. Tags the ledger-backed money flow (Expense,
// FundAllocation) and the project's current stage; NOT the legacy
// Block-rooted ProjectPhase/ProjectBudget system (ad-hoc, per-project phases,
// out of scope — see PROGRESS.md D1 debt). Additive/nullable throughout: no
// existing row needs a stage to remain valid.
enum ExecutionStage {
  planning
  procurement
  execution
  inspection
  completion
}

enum FundDonationMethod {
  cash
  bank_transfer
  check
  card
  online
}

enum ExpenseCategory {
  materials
  labor
  services
  equipment
  transport
  administrative
  other
}

enum OrganizationType {
  ngo
  municipality
  youth_team
  initiative
  board
  council
}

enum OrganizationStatus {
  pending_verification
  active
  suspended
  archived
}

enum MembershipStatus {
  active
  suspended
}

enum RoleScopeType {
  platform
  organization
  fund
  project
}

// ─── Wave 6 enums (17_WAVE_6_MUNICIPAL_INTEGRATION.md) ───────────────────────

enum ParticipationRole {
  owner
  executing_agency
  funding_partner
  supervising
  beneficiary_rep
}

enum ParticipationStatus {
  active
  ended
}

enum FundingAgreementStatus {
  draft
  active
  suspended
  completed
  terminated
}

enum OrgReportType {
  progress
  financial
}

enum OrgReportStatus {
  submitted
  under_review
  accepted
  returned
}

// ─── Languages ────────────────────────────────────────────────────────────────

model Language {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(10)
  flagCode  String?   @map("flag_code") @db.VarChar(10)
  direction Direction @default(ltr)
  order     Int       @default(0) @map("order_id")
  isActive  Boolean   @default(true) @map("is_active")

  blockTranslations BlockTranslation[]

  @@map("languages")
}

// ─── Blocks (Content) ────────────────────────────────────────────────────────

model Block {
  id             Int           @id @default(autoincrement())
  category       BlockCategory
  imageUrl       String?       @map("image_url") @db.Text
  fileUrl        String?       @map("file_url") @db.Text
  classification String?       @db.VarChar(255)
  orderId        Int           @default(0) @map("order_id")
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  translations BlockTranslation[]
  files        File[]
  project      Project?

  steps           ProjectStep[]        @relation("StepProject")
  stepBlocks      ProjectStep[]        @relation("StepBlock")
  phases          ProjectPhase[]       @relation("PhaseProject")
  phaseBlocks     ProjectPhase[]       @relation("PhaseBlock")
  tasks           ProjectTask[]        @relation("TaskProject")
  taskBlocks      ProjectTask[]        @relation("TaskBlock")
  budgets         ProjectBudget[]      @relation("BudgetProject")
  budgetBlocks    ProjectBudget[]      @relation("BudgetBlock")
  expenses        ProjectExpense[]     @relation("ExpenseProject")
  expenseBlocks   ProjectExpense[]     @relation("ExpenseBlock")
  transactions    ProjectTransaction[] @relation("TransactionProject")
  milestones      ProjectMilestone[]   @relation("MilestoneProject")
  milestoneBlocks ProjectMilestone[]   @relation("MilestoneBlock")
  organization    Organization?

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@map("blocks")
}

model BlockTranslation {
  id           Int      @id @default(autoincrement())
  blockId      Int      @map("block_id")
  languageCode String   @map("language_code") @db.VarChar(10)
  name         String   @db.VarChar(500)
  slug         String   @unique @db.VarChar(500)
  brief        String   @db.Text
  description  String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  block    Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([blockId, languageCode])
  @@map("block_translations")
}

// ─── Files (Polymorphic) ─────────────────────────────────────────────────────

model File {
  id            Int      @id @default(autoincrement())
  referenceId   Int      @map("reference_id")
  referenceType String   @map("reference_type") @db.VarChar(50)
  name          String?  @db.VarChar(255)
  url           String   @db.Text
  orderId       Int      @default(0) @map("order_id")
  isActive      Boolean  @default(true) @map("is_active")
  isCover       Boolean  @default(false) @map("is_cover")
  fileType      FileType @map("file_type")
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  block Block? @relation(fields: [referenceId], references: [id], map: "files_block_fk")

  @@index([referenceId, referenceType])
  @@map("files")
}

// ─── Admins ───────────────────────────────────────────────────────────────────

model Admin {
  id        Int       @id @default(autoincrement())
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  role      AdminRole @default(employee)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user              User?
  assignedProjects  Project[]         @relation("FinancialOfficerProjects")
  approvedDonations ProjectDonation[] @relation("ApprovedBy")
  createdStudies    ProjectStudy[]    @relation("StudyCreatedBy")
  approvedStudies   ProjectStudy[]    @relation("StudyApprovedBy")
  assignedSections  StudySection[]    @relation("SectionAssignedTo")
  assignedTasks     ProjectTask[]     @relation("TaskAssignee")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@map("admins")
}

// ─── Participants ─────────────────────────────────────────────────────────────

model Participant {
  id             Int            @id @default(autoincrement())
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  representation Representation @default(personal)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user            User?
  donations       ProjectDonation[]
  onlineDonations OnlineDonation[]
  fundDonations   FundDonation[]
  // W9-stabilization — Funding Platform Audit §5: links a logged-in donor's
  // Participant identity to any staff-managed Donor record entered for the
  // same person (e.g. a cash/check gift), so donor reports can aggregate
  // across channels instead of leaving two disconnected identities.
  donorRecords    Donor[]           @relation("DonorParticipant")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@map("participants")
}

// ─── Users (Auth - Polymorphic) ───────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  referenceId     Int       @map("reference_id")
  referenceType   String    @map("reference_type") @db.VarChar(50)
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String?   @db.Text
  avatar          String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  rememberToken   String?   @map("remember_token") @db.Text
  joiningDate     DateTime? @map("joining_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  adminId       Int? @unique @map("admin_id")
  participantId Int? @unique @map("participant_id")

  admin                   Admin?                   @relation(fields: [adminId], references: [id])
  participant             Participant?             @relation(fields: [participantId], references: [id])
  refreshTokens           RefreshToken[]
  studyVotes              StudyVote[]
  notifications           Notification[]
  organizationMemberships OrganizationMembership[]
  roleAssignments         RoleAssignment[]
  assignedSections        StudySection[]           @relation("SectionAssignedUser")
  assignedTasks           ProjectTask[]            @relation("TaskAssignedUser")
  createdStudies          ProjectStudy[]           @relation("StudyCreatedByUser")
  approvedStudies         ProjectStudy[]           @relation("StudyApprovedByUser")
  approvedDonations       ProjectDonation[]        @relation("DonationApprovedByUser")
  boardDecisions          BoardDecision[]          @relation("BoardDecisionDecidedBy")
  governanceVotes         Vote[]                   @relation("VoteUser")
  fundMemberships         FundMembership[]

  // W8 — fund financial extension: donors/recipients/invoices are
  // staff-managed master data; fund donations and expenses are the two new
  // money-movement records. Every actor relation is a real FK (unlike the
  // bare createdByUserId ints on FundAllocation/FundingAgreement/
  // ProjectParticipation from earlier waves — deliberately not repeated here).
  createdDonors         Donor[]        @relation("DonorCreatedBy")
  createdRecipients     Recipient[]    @relation("RecipientCreatedBy")
  createdInvoices       Invoice[]      @relation("InvoiceCreatedBy")
  createdFundDonations  FundDonation[] @relation("FundDonationCreatedBy")
  approvedFundDonations FundDonation[] @relation("FundDonationApprovedBy")
  createdExpenses       Expense[]      @relation("ExpenseCreatedBy")
  approvedExpenses      Expense[]      @relation("ExpenseApprovedBy")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@unique([referenceId, referenceType])
  @@index([referenceId, referenceType])
  @@index([referenceType])
  @@map("users")
}

// ─── Refresh Tokens ───────────────────────────────────────────────────────────

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id                  Int              @id @default(autoincrement())
  blockId             Int              @unique @map("block_id")
  location            String?          @db.VarChar(255)
  dateOfCompletion    DateTime?        @map("date_of_completion")
  value               Decimal          @db.Decimal(15, 2)
  progression         Decimal          @default(0) @db.Decimal(5, 2)
  isCompleted         Boolean          @default(false) @map("is_completed")
  // W6-E2 (category migration, 09 "adding a truth"): the enum column is
  // FROZEN — nullable, never written by application code; categoryId is the
  // truth. Column dropped in Wave 8.
  category            ProjectCategory?
  categoryId          Int?             @map("category_id")
  expectedStartDate   DateTime?        @map("expected_start_date")
  financialOfficerId  Int?             @map("financial_officer_id")
  studyStatus         StudyStatus?     @map("study_status")
  ownerOrganizationId Int              @map("owner_organization_id")
  // W9-stabilization — Funding Platform Audit §3: current stage in the
  // standard execution lifecycle (tagging only, see ExecutionStage comment).
  currentStage        ExecutionStage?  @map("current_stage")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  block             Block                @relation(fields: [blockId], references: [id], onDelete: Restrict)
  financialOfficer  Admin?               @relation("FinancialOfficerProjects", fields: [financialOfficerId], references: [id])
  ownerOrganization Organization         @relation("OrganizationProjects", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  categoryNode      ProjectCategoryNode? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  donations         ProjectDonation[]
  study             ProjectStudy?
  onlineDonations   OnlineDonation[]
  stepsRef          ProjectStep[]        @relation("StepProjectRef")
  phasesRef         ProjectPhase[]       @relation("PhaseProjectRef")
  tasksRef          ProjectTask[]        @relation("TaskProjectRef")
  budgetsRef        ProjectBudget[]      @relation("BudgetProjectRef")
  expensesRef       ProjectExpense[]     @relation("ExpenseProjectRef")
  transactionsRef   ProjectTransaction[] @relation("TransactionProjectRef")
  milestonesRef     ProjectMilestone[]   @relation("MilestoneProjectRef")

  allocations    FundAllocation[]
  expenses       Expense[]
  participations ProjectParticipation[]
  orgReports     OrganizationReport[]

  // W6 addendum — "fund of record": administrative fund attribution (like
  // ownerOrganizationId, chosen at creation, locked once Board-approved).
  // Distinct from FundAllocation, which stays many-to-many for actual
  // financing/co-funding (03_DATA_MODEL.md:90). Nullable during backfill;
  // see packages/database/prisma/backfills/w6-project-fund-backfill.ts.
  primaryFundId Int?  @map("primary_fund_id")
  primaryFund   Fund? @relation("ProjectPrimaryFund", fields: [primaryFundId], references: [id], onDelete: Restrict)

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([categoryId])
  @@index([primaryFundId])
  @@map("projects")
}

// ─── Donations ────────────────────────────────────────────────────────────────

model ProjectDonation {
  id            Int            @id @default(autoincrement())
  projectId     Int            @map("project_id")
  participantId Int            @map("participant_id")
  amount        Decimal        @db.Decimal(15, 2)
  status        DonationStatus @default(pending)
  qrToken       String         @unique @map("qr_token") @db.VarChar(255)
  approvedBy    Int?           @map("approved_by")
  approvedAt    DateTime?      @map("approved_at")
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  approver    Admin?      @relation("ApprovedBy", fields: [approvedBy], references: [id])

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E2 (D2 repair): User-FK twin beside the legacy Admin-FK
  approvedByUserId Int?  @map("approved_by_user_id")
  approvedByUser   User? @relation("DonationApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([participantId])
  @@index([status])
  @@map("project_donations")
}

// ─── Password Reset Tokens ────────────────────────────────────────────────────

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

// ─── Study System ─────────────────────────────────────────────────────────────

model StudyDepartmentTemplate {
  id             Int                  @id @default(autoincrement())
  // W6-E2-S2: re-keyed to category nodes; the enum column is FROZEN (nullable,
  // unwritten-to after cutover; dropped Wave 8). Civic templates carry only
  // categoryNodeId.
  projectType    ProjectType?         @map("project_type")
  categoryNodeId Int?                 @map("category_node_id")
  categoryNode   ProjectCategoryNode? @relation(fields: [categoryNodeId], references: [id], onDelete: Restrict)
  name           String               @db.VarChar(255)
  nameAr         String?              @map("name_ar") @db.VarChar(255)
  nameFr         String?              @map("name_fr") @db.VarChar(255)
  description    String?              @db.Text
  descriptionAr  String?              @map("description_ar") @db.Text
  descriptionFr  String?              @map("description_fr") @db.Text
  isRequired     Boolean              @default(true) @map("is_required")
  order          Int
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([categoryNodeId])
  @@map("study_department_templates")
}

model ProjectStudy {
  id              Int         @id @default(autoincrement())
  projectId       Int         @unique @map("project_id")
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status          StudyStatus @default(draft)
  summary         String?     @db.Text
  publishedAt     DateTime?   @map("published_at")
  votingStartsAt  DateTime?   @map("voting_starts_at")
  votingEndsAt    DateTime?   @map("voting_ends_at")
  approvedById    Int?        @map("approved_by_id")
  approvedBy      Admin?      @relation("StudyApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason") @db.Text
  reminderSentAt  DateTime?   @map("reminder_sent_at")
  createdById     Int         @map("created_by_id")
  createdBy       Admin       @relation("StudyCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sections StudySection[]
  votes    StudyVote[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E2 (D2 repair): User-FK twins beside the legacy Admin-FKs
  createdByUserId  Int?  @map("created_by_user_id")
  createdByUser    User? @relation("StudyCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId Int?  @map("approved_by_user_id")
  approvedByUser   User? @relation("StudyApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@map("project_studies")
}

model StudySection {
  id            Int           @id @default(autoincrement())
  studyId       Int           @map("study_id")
  study         ProjectStudy  @relation(fields: [studyId], references: [id], onDelete: Restrict)
  name          String        @db.VarChar(255)
  nameAr        String?       @map("name_ar") @db.VarChar(255)
  nameFr        String?       @map("name_fr") @db.VarChar(255)
  description   String?       @db.Text
  descriptionAr String?       @map("description_ar") @db.Text
  descriptionFr String?       @map("description_fr") @db.Text
  content       String?       @db.Text
  status        SectionStatus @default(pending)
  order         Int
  isRequired    Boolean       @default(true) @map("is_required")
  assignedTo    Int?          @map("assigned_to")
  assignedAdmin Admin?        @relation("SectionAssignedTo", fields: [assignedTo], references: [id])
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  files StudySectionFile[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E2 (D2 repair): User-FK twin beside the legacy Admin-FK
  assignedToUserId Int?  @map("assigned_to_user_id")
  assignedUser     User? @relation("SectionAssignedUser", fields: [assignedToUserId], references: [id], onDelete: Restrict)

  @@index([studyId])
  @@map("study_sections")
}

model StudySectionFile {
  id        Int          @id @default(autoincrement())
  sectionId Int          @map("section_id")
  section   StudySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String       @db.VarChar(255)
  url       String       @db.Text
  fileType  FileType     @map("file_type")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([sectionId])
  @@map("study_section_files")
}

model StudyVote {
  id        Int          @id @default(autoincrement())
  studyId   Int          @map("study_id")
  study     ProjectStudy @relation(fields: [studyId], references: [id], onDelete: Restrict)
  userId    Int          @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  choice    VoteChoice
  comment   String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([studyId, userId])
  @@map("study_votes")
}

// ─── Online Donations (Stripe / PayPal) ──────────────────────────────────────

model OnlineDonation {
  id                Int             @id @default(autoincrement())
  // W5: fund-directed donations — exactly one of projectId | fundId is set
  projectId         Int?            @map("project_id")
  project           Project?        @relation(fields: [projectId], references: [id])
  fundId            Int?            @map("fund_id")
  // W8 — the column has existed (and been posted against) since W5; only the
  // Prisma-level relation was missing. No orphaned values existed at
  // migration time (verified), so this is a safe additive FK.
  fund              Fund?           @relation(fields: [fundId], references: [id], onDelete: Restrict)
  participantId     Int?            @map("participant_id")
  participant       Participant?    @relation(fields: [participantId], references: [id])
  amount            Decimal         @db.Decimal(15, 2)
  currency          String          @default("USD") @db.VarChar(10)
  provider          PaymentProvider
  providerSessionId String          @unique @map("provider_session_id") @db.VarChar(500)
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(500)
  status            PaymentStatus   @default(pending)
  metadata          Json?
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([fundId])
  @@index([participantId])
  @@index([status])
  @@map("online_donations")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    @db.VarChar(100)
  title         String    @db.VarChar(500)
  body          String    @db.Text
  isRead        Boolean   @default(false) @map("is_read")
  readAt        DateTime? @map("read_at")
  referenceId   Int?      @map("reference_id")
  referenceType String?   @map("reference_type") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Project Execution ────────────────────────────────────────────────────────

model ProjectStep {
  id        Int        @id @default(autoincrement())
  projectId Int        @map("project_id")
  blockId   Int        @map("block_id")
  parentId  Int?       @map("parent_id")
  status    StepStatus @default(pending)
  priority  Int        @default(0)
  startDate DateTime?  @map("start_date")
  endDate   DateTime?  @map("end_date")
  progress  Decimal    @default(0) @db.Decimal(5, 2)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  project  Block         @relation("StepProject", fields: [projectId], references: [id])
  block    Block         @relation("StepBlock", fields: [blockId], references: [id])
  parent   ProjectStep?  @relation("StepChildren", fields: [parentId], references: [id])
  children ProjectStep[] @relation("StepChildren")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("StepProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectRefId])
  @@map("project_steps")
}

model ProjectPhase {
  id        Int         @id @default(autoincrement())
  projectId Int         @map("project_id")
  blockId   Int         @map("block_id")
  order     Int         @default(0)
  status    PhaseStatus @default(pending)
  startDate DateTime?   @map("start_date")
  endDate   DateTime?   @map("end_date")
  progress  Decimal     @default(0) @db.Decimal(5, 2)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project Block         @relation("PhaseProject", fields: [projectId], references: [id])
  block   Block         @relation("PhaseBlock", fields: [blockId], references: [id])
  tasks   ProjectTask[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("PhaseProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectRefId])
  @@map("project_phases")
}

model ProjectTask {
  id           Int        @id @default(autoincrement())
  projectId    Int        @map("project_id")
  phaseId      Int?       @map("phase_id")
  blockId      Int        @map("block_id")
  assignedToId Int?       @map("assigned_to_id")
  status       TaskStatus @default(pending)
  progress     Decimal    @default(0) @db.Decimal(5, 2)
  startDate    DateTime?  @map("start_date")
  endDate      DateTime?  @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  project    Block         @relation("TaskProject", fields: [projectId], references: [id])
  block      Block         @relation("TaskBlock", fields: [blockId], references: [id])
  phase      ProjectPhase? @relation(fields: [phaseId], references: [id])
  assignedTo Admin?        @relation("TaskAssignee", fields: [assignedToId], references: [id])

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("TaskProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  // W2-E2 (D2 repair): User-FK twin beside the legacy Admin-FK
  assignedToUserId Int?  @map("assigned_to_user_id")
  assignedUser     User? @relation("TaskAssignedUser", fields: [assignedToUserId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([phaseId])
  @@index([projectRefId])
  @@map("project_tasks")
}

// ─── Project Financial ────────────────────────────────────────────────────────

model ProjectBudget {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  blockId         Int      @map("block_id")
  estimatedAmount Decimal  @map("estimated_amount") @db.Decimal(15, 2)
  approvedAmount  Decimal? @map("approved_amount") @db.Decimal(15, 2)
  actualAmount    Decimal  @default(0) @map("actual_amount") @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project  Block            @relation("BudgetProject", fields: [projectId], references: [id])
  block    Block            @relation("BudgetBlock", fields: [blockId], references: [id])
  expenses ProjectExpense[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("BudgetProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectRefId])
  @@map("project_budgets")
}

model ProjectExpense {
  id         Int           @id @default(autoincrement())
  projectId  Int           @map("project_id")
  blockId    Int           @map("block_id")
  budgetId   Int?          @map("budget_id")
  amount     Decimal       @db.Decimal(15, 2)
  invoiceRef String?       @map("invoice_ref") @db.VarChar(255)
  status     ExpenseStatus @default(pending)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  project Block          @relation("ExpenseProject", fields: [projectId], references: [id])
  block   Block          @relation("ExpenseBlock", fields: [blockId], references: [id])
  budget  ProjectBudget? @relation(fields: [budgetId], references: [id])

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("ExpenseProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([budgetId])
  @@index([projectRefId])
  @@map("project_expenses")
}

model ProjectTransaction {
  id            Int             @id @default(autoincrement())
  projectId     Int             @map("project_id")
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  referenceType String?         @map("reference_type") @db.VarChar(50)
  referenceId   Int?            @map("reference_id")
  notes         String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")

  project Block @relation("TransactionProject", fields: [projectId], references: [id])

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("TransactionProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([referenceType, referenceId])
  @@index([projectRefId])
  @@map("project_transactions")
}

// ─── Project Milestones ───────────────────────────────────────────────────────

model ProjectMilestone {
  id          Int             @id @default(autoincrement())
  projectId   Int             @map("project_id")
  blockId     Int             @map("block_id")
  targetDate  DateTime?       @map("target_date")
  completedAt DateTime?       @map("completed_at")
  status      MilestoneStatus @default(pending)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  project Block @relation("MilestoneProject", fields: [projectId], references: [id])
  block   Block @relation("MilestoneBlock", fields: [blockId], references: [id])

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  // W2-E1 (D1 repair): real Project FK; legacy projectId still points at Block
  projectRefId Int?     @map("project_ref_id")
  projectRef   Project? @relation("MilestoneProjectRef", fields: [projectRefId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectRefId])
  @@map("project_milestones")
}

// ─── Webhook Logs ─────────────────────────────────────────────────────────────

model WebhookLog {
  id          Int       @id @default(autoincrement())
  provider    String    @db.VarChar(50)
  eventType   String    @map("event_type") @db.VarChar(255)
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("webhook_logs")
}

// ─── Audit Log (W0-E3, append-only) ──────────────────────────────────────────
// Written by the audit subscriber from domain events; never updated or
// deleted — corrections are new compensating rows (03_DATA_MODEL.md §6).

model AuditLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  actorUserId Int?     @map("actor_user_id")
  actorOrgId  Int?     @map("actor_org_id") // populated from Wave 1 (activeOrgId)
  action      String   @db.VarChar(255) // domain event name, e.g. "project.created"
  subjectType String   @map("subject_type") @db.VarChar(100)
  subjectId   String   @map("subject_id") @db.VarChar(100)
  before      Json?
  after       Json?
  requestId   String   @map("request_id") @db.VarChar(128)
  ip          String?  @db.VarChar(64)

  // Idempotency key for the event subscriber (replayed event → no duplicate)
  @@unique([requestId, action, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@index([actorUserId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── Organizations (W1-E1, multi-tenancy) ─────────────────────────────────────
// 03_DATA_MODEL.md §1. No cascades on domain relations; soft-delete columns
// per the Wave 0 convention.

model Organization {
  id                 Int                @id @default(autoincrement())
  type               OrganizationType
  name               String             @db.VarChar(255)
  status             OrganizationStatus @default(pending_verification)
  // { canExecuteProjects, canReceivePublicFunds, canOpenDonations,
  //   isGovernmentEntity, requiresBoardOversight }
  capabilities       Json               @default("{}")
  registrationNumber String?            @map("registration_number") @db.VarChar(255)
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         Int?               @map("verified_by")
  contentBlockId     Int?               @unique @map("content_block_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  contentBlock      Block?                   @relation(fields: [contentBlockId], references: [id], onDelete: Restrict)
  memberships       OrganizationMembership[]
  ownedProjects     Project[]                @relation("OrganizationProjects")
  managedFunds      Fund[]
  participations    ProjectParticipation[]
  fundingAgreements FundingAgreement[]
  orgReports        OrganizationReport[]
  // W8 — recipients that are also known platform organizations (optional
  // cross-reference; a recipient does not have to be one).
  recipients        Recipient[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([type])
  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             Int              @id @default(autoincrement())
  organizationId Int              @map("organization_id")
  userId         Int              @map("user_id")
  status         MembershipStatus @default(active)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// ─── Role assignments (W1-E1-S2, replaces AdminRole semantics — D5) ──────────
// role strings come from the role catalog (08_PERMISSIONS_RBAC_ABAC.md).
// scopeId is null for platform scope; the unique constraint therefore cannot
// dedupe platform grants at the DB level (Postgres treats NULLs as distinct)
// — writers must upsert via findFirst (see the W1-E3 backfill).

model RoleAssignment {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  role      String        @db.VarChar(100)
  scopeType RoleScopeType @map("scope_type")
  scopeId   Int?          @map("scope_id")
  grantedBy Int?          @map("granted_by")
  grantedAt DateTime      @default(now()) @map("granted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@unique([userId, role, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([userId])
  @@map("role_assignments")
}

// ─── Governance (W3-E1-S1, shapes: 03_DATA_MODEL.md §4) ──────────────────────
// BoardDecision and Vote are IMMUTABLE by convention: application code must
// never update or delete rows (no such service/endpoint exists; the one
// compatibility exception is the legacy change-vote path on OPEN rounds,
// retired in Wave 8). Corrections are new decisions, never edits.

enum GovernanceSubjectType {
  project
  project_study
  fund_allocation
  organization
  policy
}

enum BoardDecisionType {
  approved
  rejected
  changes_requested
}

enum VoteRoundStatus {
  open
  closed
}

model BoardDecision {
  id          Int                   @id @default(autoincrement())
  subjectType GovernanceSubjectType @map("subject_type")
  subjectId   Int                   @map("subject_id")
  decision    BoardDecisionType
  rationale   String                @db.Text
  decidedById Int                   @map("decided_by_user_id")
  decidedBy   User                  @relation("BoardDecisionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime              @default(now()) @map("decided_at")
  sessionRef  String?               @map("session_ref") @db.VarChar(100)
  voteRoundId Int?                  @map("vote_round_id")
  voteRound   VoteRound?            @relation(fields: [voteRoundId], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now()) @map("created_at")

  approvedAllocations FundAllocation[]

  @@index([subjectType, subjectId])
  @@index([decidedById])
  @@map("board_decisions")
}

model VoteRound {
  id             Int                   @id @default(autoincrement())
  subjectType    GovernanceSubjectType @map("subject_type")
  subjectId      Int                   @map("subject_id")
  status         VoteRoundStatus       @default(open)
  opensAt        DateTime              @map("opens_at")
  closesAt       DateTime?             @map("closes_at")
  // Eligibility policy expression (07): default transcribes current study
  // voting — any authenticated user. No electorate expansion in Wave 3.
  eligibility    Json                  @default("{\"type\": \"authenticated\"}")
  // Quorum & threshold rules; empty = tally only (current behavior: humans decide)
  rules          Json                  @default("{}")
  // Tally + pass/fail recorded at close by the governance service
  result         Json?
  reminderSentAt DateTime?             @map("reminder_sent_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  votes     Vote[]
  decisions BoardDecision[]

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("vote_rounds")
}

model Vote {
  id          Int        @id @default(autoincrement())
  voteRoundId Int        @map("vote_round_id")
  voteRound   VoteRound  @relation(fields: [voteRoundId], references: [id], onDelete: Restrict)
  userId      Int        @map("user_id")
  user        User       @relation("VoteUser", fields: [userId], references: [id], onDelete: Restrict)
  choice      VoteChoice
  comment     String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([voteRoundId, userId])
  @@index([userId])
  @@map("votes")
}

// ─── Workflow engine (W4-E1-S1, shapes: 04_WORKFLOW_ENGINE.md) ───────────────
// Definitions/states/transitions are versioned data; instances pin their
// definition (and thereby its version). WorkflowStepLog is append-only: the
// engine only inserts, never updates or deletes (lifecycle audit).

enum WorkflowStateKind {
  initial
  normal
  terminal
}

model WorkflowDefinition {
  id          Int      @id @default(autoincrement())
  key         String   @db.VarChar(100)
  version     Int
  subjectType String   @map("subject_type") @db.VarChar(50)
  isActive    Boolean  @default(false) @map("is_active")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([key, version])
  @@map("workflow_definitions")
}

model WorkflowState {
  id           Int                @id @default(autoincrement())
  definitionId Int                @map("definition_id")
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  key          String             @db.VarChar(100)
  kind         WorkflowStateKind  @default(normal)
  metadata     Json               @default("{}")

  @@unique([definitionId, key])
  @@map("workflow_states")
}

model WorkflowTransition {
  id           Int                @id @default(autoincrement())
  definitionId Int                @map("definition_id")
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  fromStateKey String             @map("from_state_key") @db.VarChar(100)
  toStateKey   String             @map("to_state_key") @db.VarChar(100)
  actionKey    String             @map("action_key") @db.VarChar(100)
  // list of named guard refs + params, e.g. [{"type":"board_decision","decision":"approved"}]
  guards       Json               @default("[]")
  // domain-event names emitted on success, e.g. ["vote_round.create"]
  effects      Json               @default("[]")

  @@unique([definitionId, fromStateKey, actionKey])
  @@map("workflow_transitions")
}

model WorkflowInstance {
  id              Int                @id @default(autoincrement())
  definitionId    Int                @map("definition_id")
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  subjectType     String             @map("subject_type") @db.VarChar(50)
  subjectId       Int                @map("subject_id")
  currentStateKey String             @map("current_state_key") @db.VarChar(100)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  stepLogs WorkflowStepLog[]

  @@unique([subjectType, subjectId])
  @@map("workflow_instances")
}

model WorkflowStepLog {
  id           Int              @id @default(autoincrement())
  instanceId   Int              @map("instance_id")
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  fromStateKey String?          @map("from_state_key") @db.VarChar(100)
  toStateKey   String           @map("to_state_key") @db.VarChar(100)
  actionKey    String           @map("action_key") @db.VarChar(100)
  actorUserId  Int?             @map("actor_user_id")
  note         String?          @db.Text
  payload      Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([instanceId])
  @@map("workflow_step_logs")
}

// ─── Funds & treasury (W5-E1, shapes: 03_DATA_MODEL.md §3) ───────────────────
// LedgerTransaction and LedgerEntry are IMMUTABLE: the treasury module only
// inserts; corrections are reversing transactions, never edits or deletes.
// Balances are always derived from entries.

enum FundStatus {
  active
  frozen
  closed
}

enum AccountOwnerType {
  fund
  project
  provider_clearing
  external
}

enum AccountKind {
  asset
  liability
  income
  expense
}

enum LedgerDirection {
  debit
  credit
}

enum LedgerTransactionStatus {
  pending
  posted
  reversed
}

enum FundAllocationStatus {
  proposed
  board_approved
  disbursing
  reconciled
  closed
  rejected
}

model Fund {
  id                     Int                  @id @default(autoincrement())
  name                   String               @db.VarChar(255)
  purpose                String?              @db.Text
  status                 FundStatus           @default(active)
  // W8 — classification. Council funds are managed by an Organization row of
  // type `council` (no separate Council table — see the fork decision in the
  // Wave 8 architecture note); Donor funds are owned by a Donor instead.
  // Defaults 'organization' so the backfill migration is a no-op for every
  // existing fund (all pre-W8 funds are either org-managed or unmanaged).
  type                   FundType             @default(organization)
  managingOrganizationId Int?                 @map("managing_organization_id")
  managingOrganization   Organization?        @relation(fields: [managingOrganizationId], references: [id], onDelete: Restrict)
  donorId                Int?                 @map("donor_id")
  donor                  Donor?               @relation(fields: [donorId], references: [id], onDelete: Restrict)
  // W9 — hierarchy: which sector this fund represents (master funds) or is
  // scoped to (an organization fund's sector — its parent is that sector's
  // master fund). Both optional: pre-W9 flat funds are untouched, and a
  // donor fund is not required to sit in the taxonomy at all.
  categoryId             Int?                 @map("category_id")
  categoryNode           ProjectCategoryNode? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentFundId           Int?                 @map("parent_fund_id")
  parentFund             Fund?                @relation("FundHierarchy", fields: [parentFundId], references: [id], onDelete: Restrict)
  childFunds             Fund[]               @relation("FundHierarchy")
  // { dualApprovalThreshold, spendingLimit, allowedCategories }
  policy                 Json                 @default("{}")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  memberships     FundMembership[]
  allocations     FundAllocation[]
  agreements      FundingAgreement[]
  fundDonations   FundDonation[]
  expenses        Expense[]
  onlineDonations OnlineDonation[]
  // W6 addendum — projects whose fund of record is this fund (identity, not
  // financing; see Project.primaryFundId).
  primaryProjects Project[]          @relation("ProjectPrimaryFund")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([type])
  @@index([categoryId])
  @@index([parentFundId])
  @@map("funds")
}

model FundMembership {
  id        Int      @id @default(autoincrement())
  fundId    Int      @map("fund_id")
  fund      Fund     @relation(fields: [fundId], references: [id], onDelete: Restrict)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fundId, userId])
  @@index([userId])
  @@map("fund_memberships")
}

model Account {
  id        Int              @id @default(autoincrement())
  ownerType AccountOwnerType @map("owner_type")
  ownerId   Int?             @map("owner_id")
  name      String           @db.VarChar(255)
  currency  String           @default("USD") @db.VarChar(10)
  kind      AccountKind      @default(asset)
  createdAt DateTime         @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([ownerType, name, currency])
  @@index([ownerType, ownerId])
  @@map("accounts")
}

model LedgerTransaction {
  id            Int                     @id @default(autoincrement())
  timestamp     DateTime                @default(now())
  actorUserId   Int?                    @map("actor_user_id")
  description   String                  @db.Text
  referenceType String?                 @map("reference_type") @db.VarChar(50)
  referenceId   Int?                    @map("reference_id")
  // idempotency event discriminator, e.g. 'donation.approved'
  event         String?                 @db.VarChar(100)
  status        LedgerTransactionStatus @default(posted)
  createdAt     DateTime                @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([referenceType, referenceId, event])
  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            Int               @id @default(autoincrement())
  transactionId Int               @map("transaction_id")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     Int               @map("account_id")
  account       Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction     LedgerDirection
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("USD") @db.VarChar(10)

  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FundAllocation {
  id                   Int                  @id @default(autoincrement())
  fundId               Int                  @map("fund_id")
  fund                 Fund                 @relation(fields: [fundId], references: [id], onDelete: Restrict)
  projectId            Int                  @map("project_id")
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  amount               Decimal              @db.Decimal(14, 2)
  status               FundAllocationStatus @default(proposed)
  approvedByDecisionId Int?                 @map("approved_by_decision_id")
  approvedByDecision   BoardDecision?       @relation(fields: [approvedByDecisionId], references: [id], onDelete: Restrict)
  // W6-E1-S2: municipal funding channel — allocations may reference the
  // FundingAgreement whose terms govern them (reporting obligations,
  // disbursement blocks).
  fundingAgreementId   Int?                 @map("funding_agreement_id")
  fundingAgreement     FundingAgreement?    @relation(fields: [fundingAgreementId], references: [id], onDelete: Restrict)
  note                 String?              @db.Text
  createdByUserId      Int?                 @map("created_by_user_id")
  // W9 — true for the auto-allocation MoneyEventsSubscriber creates when a
  // direct project donation is routed through the project's default fund
  // (created already `reconciled`, no BoardDecision — see that method's
  // comment). Distinguishes it from a manually proposed/board-approved
  // allocation for exactly one purpose: TreasuryService.reconciliation()
  // must NOT exclude it from the legacy↔ledger comparison the way it
  // excludes real multi-fund financing allocations, because — unlike those —
  // an auto-allocation DOES have a legacy counterpart (the donation itself,
  // dual-written on the leg that credits the fund).
  isAutoAllocated      Boolean              @default(false) @map("is_auto_allocated")
  // W9-stabilization — Funding Platform Audit §3: which execution stage this
  // allocation (reserved budget) was made for.
  stage                ExecutionStage?      @map("stage")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([fundId])
  @@index([projectId])
  @@index([fundingAgreementId])
  @@map("fund_allocations")
}

// ─── Wave 8 — fund financial extension ───────────────────────────────────────
// Donor: the counterparty on a FundDonation (and the owner of `donor`-type
// Funds) — staff-managed identity, not an auth principal, same relationship
// Organization has to User. Recipient/Invoice/Expense are the successor to
// ProjectExpense (Block-keyed, frozen — see the comment on that model):
// Expense always names who was paid, how much, why, for which project, from
// which fund, and (once attached) which invoice supports it. Money movement
// records (FundDonation, Expense) carry no deletedAt/deletedBy — financial
// records are never deleted, only status-transitioned (reject), per the W8
// audit requirement; Donor/Recipient/Invoice are reference data and keep the
// standard soft-delete columns.

model Donor {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(255)
  type            PartyType    @default(person)
  contactEmail    String?      @map("contact_email") @db.VarChar(255)
  contactPhone    String?      @map("contact_phone") @db.VarChar(50)
  contactAddress  String?      @map("contact_address") @db.Text
  taxId           String?      @map("tax_id") @db.VarChar(100)
  notes           String?      @db.Text
  createdByUserId Int?         @map("created_by_user_id")
  createdByUser   User?        @relation("DonorCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  // W9-stabilization — Funding Platform Audit §5: optional link to the same
  // person's logged-in Participant identity (see Participant.donorRecords).
  // Nullable — most Donor rows are anonymous/offline gifts with no platform
  // login to link.
  participantId   Int?         @map("participant_id")
  participant     Participant? @relation("DonorParticipant", fields: [participantId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  funds     Fund[]
  donations FundDonation[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([type])
  @@map("donors")
}

// A donation whose destination is a Fund directly (not a specific Project).
// Donor → FundDonation → Fund → FundAllocation → Project is the full chain
// the money follows.
model FundDonation {
  id               Int                @id @default(autoincrement())
  fundId           Int                @map("fund_id")
  fund             Fund               @relation(fields: [fundId], references: [id], onDelete: Restrict)
  donorId          Int?               @map("donor_id")
  donor            Donor?             @relation(fields: [donorId], references: [id], onDelete: Restrict)
  // alt. counterparty: a logged-in participant donating straight to a fund
  // rather than a project (donorId and participantId are not both required —
  // either, both, or neither, e.g. an anonymous cash gift, may be set)
  participantId    Int?               @map("participant_id")
  participant      Participant?       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  amount           Decimal            @db.Decimal(14, 2)
  currency         String             @default("USD") @db.VarChar(10)
  paymentMethod    FundDonationMethod @map("payment_method")
  referenceNumber  String?            @map("reference_number") @db.VarChar(255)
  donatedAt        DateTime           @map("donated_at")
  notes            String?            @db.Text
  status           DonationStatus     @default(pending)
  createdByUserId  Int                @map("created_by_user_id")
  createdByUser    User               @relation("FundDonationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId Int?               @map("approved_by_user_id")
  approvedByUser   User?              @relation("FundDonationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime?          @map("approved_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([fundId])
  @@index([donorId])
  @@index([participantId])
  @@index([status])
  @@map("fund_donations")
}

// The counterparty on an Expense (who received the money) — person, company,
// or organization; optionally cross-referenced to a known platform Organization.
model Recipient {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(255)
  type            PartyType     @default(person)
  contactEmail    String?       @map("contact_email") @db.VarChar(255)
  contactPhone    String?       @map("contact_phone") @db.VarChar(50)
  contactAddress  String?       @map("contact_address") @db.Text
  organizationId  Int?          @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taxId           String?       @map("tax_id") @db.VarChar(100)
  notes           String?       @db.Text
  createdByUserId Int?          @map("created_by_user_id")
  createdByUser   User?         @relation("RecipientCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  expenses Expense[]
  invoices Invoice[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([type])
  @@index([organizationId])
  @@map("recipients")
}

// The supporting document for an Expense. Uploaded to local disk (matches the
// existing FilesController multer pattern) rather than through the
// polymorphic File model, whose referenceId carries a real FK to Block —
// expenses/invoices are not blocks.
model Invoice {
  id              Int        @id @default(autoincrement())
  invoiceNumber   String     @map("invoice_number") @db.VarChar(255)
  invoiceDate     DateTime   @map("invoice_date")
  recipientId     Int?       @map("recipient_id")
  recipient       Recipient? @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  fileUrl         String     @map("file_url") @db.Text
  fileName        String?    @map("file_name") @db.VarChar(255)
  fileMimeType    String?    @map("file_mime_type") @db.VarChar(100)
  fileSize        Int?       @map("file_size")
  createdByUserId Int        @map("created_by_user_id")
  createdByUser   User       @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  expenses Expense[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([recipientId])
  @@map("invoices")
}

// Successor to ProjectExpense (Block-keyed, pre-treasury — frozen). Every
// Expense answers: who was paid (recipientId), how much (amount), why
// (category + description), for which project (projectId), from which fund
// (fundId), and which invoice supports it (invoiceId). Approval posts a
// ledger transaction debiting the fund's account directly (see
// MoneyEventsSubscriber.onFundExpenseApproved) — distinct from a
// FundAllocation disbursement, which moves money fund→project first; an
// Expense is fund→recipient in one step.
model Expense {
  id               Int             @id @default(autoincrement())
  fundId           Int             @map("fund_id")
  fund             Fund            @relation(fields: [fundId], references: [id], onDelete: Restrict)
  projectId        Int             @map("project_id")
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(14, 2)
  category         ExpenseCategory
  description      String          @db.Text
  recipientId      Int             @map("recipient_id")
  recipient        Recipient       @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  invoiceId        Int?            @map("invoice_id")
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status           ExpenseStatus   @default(pending)
  createdByUserId  Int             @map("created_by_user_id")
  createdByUser    User            @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId Int?            @map("approved_by_user_id")
  approvedByUser   User?           @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime?       @map("approved_at")
  // W9-stabilization — Funding Platform Audit §2/§4: approval and payment are
  // separate steps (Expense Approval → Payment → Actual Spending). approvedAt
  // marks the approval decision; paidAt marks money actually leaving —
  // distinct dates, both may be present, only paidAt implies "actually spent".
  paidAt           DateTime?       @map("paid_at")
  // W9-stabilization — Funding Platform Audit §3: which execution stage this
  // expense was incurred for (nullable — tagging, no new relation table).
  stage            ExecutionStage? @map("stage")
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([fundId])
  @@index([projectId])
  @@index([recipientId])
  @@index([invoiceId])
  @@index([status])
  @@map("expenses")
}

// ─── Wave 6 — Municipal integration (17_WAVE_6_MUNICIPAL_INTEGRATION.md) ─────
// ProjectParticipation: joint/cross-org projects. FundingAgreement: the
// fund↔organization funding channel. OrganizationReport: formal progress/
// financial reporting (one lifecycle, two types — see the W6 decision log).
// ProjectCategoryNode: hierarchical civic taxonomy replacing both legacy
// enums (ProjectCategory, ProjectType), which are frozen and dropped Wave 8.

model ProjectParticipation {
  id              Int                 @id @default(autoincrement())
  projectId       Int                 @map("project_id")
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  organizationId  Int                 @map("organization_id")
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role            ParticipationRole
  status          ParticipationStatus @default(active)
  notes           String?             @db.Text
  createdByUserId Int?                @map("created_by_user_id")
  endedAt         DateTime?           @map("ended_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@unique([projectId, organizationId, role])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_participations")
}

model FundingAgreement {
  id                Int                    @id @default(autoincrement())
  fundId            Int                    @map("fund_id")
  fund              Fund                   @relation(fields: [fundId], references: [id], onDelete: Restrict)
  organizationId    Int                    @map("organization_id")
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title             String                 @db.VarChar(255)
  // { blockDisbursementsOnOverdueReports?: boolean (default true),
  //   graceDays?: number (default 0) }
  terms             Json                   @default("{}")
  // { frequency: 'monthly' | 'quarterly' | 'none',
  //   reportTypes: ('progress' | 'financial')[] }
  reportingSchedule Json                   @default("{}") @map("reporting_schedule")
  status            FundingAgreementStatus @default(draft)
  signedAt          DateTime?              @map("signed_at")
  startsAt          DateTime?              @map("starts_at")
  endsAt            DateTime?              @map("ends_at")
  createdByUserId   Int?                   @map("created_by_user_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  allocations FundAllocation[]
  reports     OrganizationReport[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([fundId])
  @@index([organizationId])
  @@index([status])
  @@map("funding_agreements")
}

model OrganizationReport {
  id                 Int               @id @default(autoincrement())
  type               OrgReportType
  organizationId     Int               @map("organization_id")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectId          Int?              @map("project_id")
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fundingAgreementId Int?              @map("funding_agreement_id")
  fundingAgreement   FundingAgreement? @relation(fields: [fundingAgreementId], references: [id], onDelete: Restrict)
  title              String            @db.VarChar(500)
  periodStart        DateTime?         @map("period_start")
  periodEnd          DateTime?         @map("period_end")
  // narrative/metrics; attachments ride the polymorphic File model
  // (referenceType = 'organization_report')
  payload            Json              @default("{}")
  status             OrgReportStatus   @default(submitted)
  submittedByUserId  Int?              @map("submitted_by_user_id")
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  reviewedByUserId   Int?              @map("reviewed_by_user_id")
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNote         String?           @map("review_note") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  @@index([organizationId])
  @@index([fundingAgreementId])
  @@index([status])
  @@map("organization_reports")
}

// ─── Wave 7 — publication policy (18_WAVE_7_REPORTING_TRANSPARENCY.md) ───────
// Board-controlled allowlist deciding which field classes the public
// transparency layer may serve. `never_public` classes (beneficiary data)
// are hard-excluded at query level and cannot be opened by policy.

enum PublicationVisibility {
  public
  workspace_only
  never_public
}

model PublicationPolicy {
  id              Int                   @id @default(autoincrement())
  fieldClass      String                @unique @map("field_class") @db.VarChar(100)
  visibility      PublicationVisibility
  description     String?               @db.Text
  updatedByUserId Int?                  @map("updated_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@map("publication_policies")
}

model ProjectCategoryNode {
  id                Int                   @id @default(autoincrement())
  key               String                @unique @db.VarChar(100)
  parentId          Int?                  @map("parent_id")
  parent            ProjectCategoryNode?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children          ProjectCategoryNode[] @relation("CategoryChildren")
  name              String                @db.VarChar(255)
  nameAr            String?               @map("name_ar") @db.VarChar(255)
  nameFr            String?               @map("name_fr") @db.VarChar(255)
  description       String?               @db.Text
  order             Int                   @default(0)
  isActive          Boolean               @default(true) @map("is_active")
  // Deterministic enum→node mapping, recorded on the node itself so the
  // backfill's derivation rule is reviewable data (W6-E2-S1 AC).
  legacyCategory    ProjectCategory?      @map("legacy_category")
  legacyProjectType ProjectType?          @map("legacy_project_type")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  projects  Project[]
  templates StudyDepartmentTemplate[]
  // W9 — the sector's master fund (and any funds otherwise scoped to it).
  funds     Fund[]

  @@index([parentId])
  @@map("project_category_nodes")
}
