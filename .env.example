# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3200
ADMIN_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/helping_hands?schema=public"

# ── JWT (Authentication tokens) ───────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@helpinghands.org
SMTP_PASS=your-smtp-password
MAIL_FROM="HelpingHands <noreply@helpinghands.org>"

# ── Next.js Public Website ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3200

# ── Next.js Admin ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api

# ── Stripe (online payments) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayPal (online payments) ──────────────────────────────────────────────────
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox

# ── Payment redirect pages ────────────────────────────────────────────────────
PAYMENT_SUCCESS_URL=http://localhost:3200/en/donations/success
PAYMENT_CANCEL_URL=http://localhost:3200/en/donations/cancel

# ── Redis (background job queues) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
