# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3200
ADMIN_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/helping_hands?schema=public"

# Used by docker-compose.prod.yml to set the postgres container's password
# and to build DATABASE_URL for the api container. Not read directly by the app.
POSTGRES_PASSWORD=change-me-to-a-strong-random-value

# E2E tests use a dedicated database (never the one above). Optional override;
# defaults to helping_hands_test on the same server.
# TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/helping_hands_test?schema=public"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Soft delete (W0-E4). Owner: platform team. OFF = legacy hard deletes.
# Rollout: staging soak with ON (W0-E5-S1), then production ON (W0-E5-S2);
# flag removal scheduled for Wave 8 consolidation.
SOFT_DELETE_ENFORCED=false

# ── JWT (Authentication tokens) ───────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@helpinghands.org
SMTP_PASS=your-smtp-password
MAIL_FROM="HelpingHands <noreply@helpinghands.org>"

# ── Next.js Public Website ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3200

# ── Next.js Admin ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WEB_URL=http://localhost:3200

# ── Stripe (online payments) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayPal (online payments) ──────────────────────────────────────────────────
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox

# ── Payment redirect pages ────────────────────────────────────────────────────
PAYMENT_SUCCESS_URL=http://localhost:3200/en/donations/success
PAYMENT_CANCEL_URL=http://localhost:3200/en/donations/cancel

# ── Redis (background job queues) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# Tenancy enforcement (W2-E3). Owner: platform team. OFF = Wave 1 behavior.
# Default ON since the W2 isolation work; set false only for rollback (09 rule).
# Removal: Wave 8 (always-on).
TENANCY_ENFORCED=true
# Policy enforcement (W2-E4). Owner: platform team. OFF = RolesGuard enforces.
POLICY_ENFORCED=true

# Workflow engine cutover (W4-E4). Owner: platform team. OFF = legacy services
# drive statuses directly. Optional WORKFLOW_SERVICES=study,voting,projects,execution
# narrows the flip for the one-service-per-deploy rollout. Removal: Wave 8.
WORKFLOW_ENFORCED=true

# Ledger-backed project financial reads (W5-E8-S1). Owner: platform team.
# OFF = legacy journal reads (rollback); dual-write keeps both identical.
TREASURY_LEDGER_READS=true

# Fund-of-record requirement (W6 addendum). Owner: platform team. OFF = fund
# selection stays optional (today's behavior) while primaryFundId backfills.
# Flip to true only after the backfill is verified in an environment. Removal:
# none planned — this is a permanent app-level validation switch, not a
# migration cutover.
PROJECT_FUND_REQUIRED=false

# ── W6 — Municipal integration flags ─────────────────────────────────────────
# Self-service org registration (municipality | youth_team). Owner: platform
# team. off = closed; allowlist = pilot mode (ORG_REGISTRATION_ALLOWLIST is
# the comma-separated list of contact emails allowed in); open = GA after
# pilot sign-off (W6-E7-S2). Verification always runs the org-verification
# workflow (documents + Board decision) regardless of this flag.
ORG_SELF_REGISTRATION=allowlist
ORG_REGISTRATION_ALLOWLIST=
# Org types creatable via the platform admin API (W1 flag, expanded per wave).
# W6 GA: municipality + youth_team enabled after the pilot review.
ORG_TYPES_ENABLED=ngo,board,municipality,youth_team

# ── Production deploy (docker-compose.prod.yml only) ─────────────────────────
# Container registry path the prod compose file pulls images from, e.g.
# ghcr.io/solvexa-stack/helpinghands. Must match IMAGE_PREFIX in the CD workflow.
IMAGE_PREFIX=ghcr.io/solvexa-stack/helpinghands
